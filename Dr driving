<!DOCTYPE html>
<html>
<head>
    <title>Mini Dr. Driving</title>
    <style>
        body { margin: 0; overflow: hidden; background: #333; font-family: sans-serif; }
        #ui { position: absolute; top: 10px; left: 10px; color: white; font-size: 20px; pointer-events: none; }
        canvas { display: block; }
    </style>
</head>
<body>
    <div id="ui">Speed: <span id="speed">0</span> km/h</div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // 1. Setup Scene
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        // 2. Lighting
        const light = new THREE.DirectionalLight(0xffffff, 1);
        light.position.set(5, 10, 5);
        scene.add(light);
        scene.add(new THREE.AmbientLight(0x404040));

        // 3. The Road
        const roadGeo = new THREE.PlaneGeometry(20, 1000);
        const roadMat = new THREE.MeshPhongMaterial({ color: 0x222222 });
        const road = new THREE.Mesh(roadGeo, roadMat);
        road.rotation.x = -Math.PI / 2;
        scene.add(road);

        // 4. The Car (The "Dr. Driving" Vehicle)
        const carGroup = new THREE.Group();
        const body = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.6, 2.5), new THREE.MeshPhongMaterial({ color: 0xff0000 }));
        body.position.y = 0.5;
        carGroup.add(body);
        
        const cabin = new THREE.Mesh(new THREE.BoxGeometry(1, 0.5, 1.2), new THREE.MeshPhongMaterial({ color: 0x333333 }));
        cabin.position.set(0, 1, -0.2);
        carGroup.add(cabin);

        scene.add(carGroup);

        // 5. Physics Variables
        let speed = 0;
        let angle = 0;
        const maxSpeed = 0.5;
        const acceleration = 0.01;
        const friction = 0.005;
        const keys = {};

        window.addEventListener('keydown', (e) => keys[e.key] = true);
        window.addEventListener('keyup', (e) => keys[e.key] = false);

        // 6. Game Loop
        function animate() {
            requestAnimationFrame(animate);

            // Driving Logic
            if (keys['ArrowUp'] || keys['w']) speed += acceleration;
            if (keys['ArrowDown'] || keys['s']) speed -= acceleration;
            
            // Steering (Only steer if moving)
            if (Math.abs(speed) > 0.01) {
                const steerDir = speed > 0 ? 1 : -1;
                if (keys['ArrowLeft'] || keys['a']) angle += 0.03 * steerDir;
                if (keys['ArrowRight'] || keys['d']) angle -= 0.03 * steerDir;
            }

            // Apply Friction
            speed *= (1 - friction);
            if (Math.abs(speed) > maxSpeed) speed = maxSpeed * Math.sign(speed);

            // Update Position
            carGroup.position.x += Math.sin(angle) * speed;
            carGroup.position.z += Math.cos(angle) * speed;
            carGroup.rotation.y = angle;

            // Follow Camera
            camera.position.set(carGroup.position.x, carGroup.position.y + 5, carGroup.position.z - 8);
            camera.lookAt(carGroup.position);

            document.getElementById('speed').innerText = Math.floor(Math.abs(speed) * 200);
            renderer.render(scene, camera);
        }

        animate();
    </script>
</body>
</html>
